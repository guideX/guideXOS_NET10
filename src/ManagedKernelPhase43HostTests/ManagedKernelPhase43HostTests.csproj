<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/gxos/src/ManagedKernelPhase43HostTests</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ManagedKernel\ManagedSha256.cs" Link="ManagedSha256.cs" />
    <Compile Include="..\ManagedKernel\ManagedHtmlTokenizer.cs" Link="ManagedHtmlTokenizer.cs" />
    <Compile Include="..\ManagedKernel\ManagedHtmlDocument.cs" Link="ManagedHtmlDocument.cs" />
  </ItemGroup>
</Project>
