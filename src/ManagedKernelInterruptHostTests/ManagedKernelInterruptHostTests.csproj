<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <StartupObject>Program</StartupObject>
    <PathMap>$(MSBuildProjectDirectory)=/gxos/src/ManagedKernelInterruptHostTests</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ManagedKernel\**\*.cs"
             Exclude="..\ManagedKernel\bin\**\*.cs;..\ManagedKernel\obj\**\*.cs"
             Link="ManagedKernel\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
