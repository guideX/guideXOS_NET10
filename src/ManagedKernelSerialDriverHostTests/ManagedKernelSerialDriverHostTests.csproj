<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <StartupObject>Program</StartupObject>
    <PathMap>$(MSBuildProjectDirectory)=/gxos/src/ManagedKernelSerialDriverHostTests</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ManagedKernel\ManagedKernel.cs" Link="ManagedKernel.cs" />
    <Compile Include="..\ManagedKernel\KernelArena.cs" Link="KernelArena.cs" />
    <Compile Include="..\ManagedKernel\KernelArenaProof.cs" Link="KernelArenaProof.cs" />
    <Compile Include="..\ManagedKernel\ManagedDeviceInventory.cs" Link="ManagedDeviceInventory.cs" />
    <Compile Include="..\ManagedKernel\ManagedDriverBinding.cs" Link="ManagedDriverBinding.cs" />
    <Compile Include="..\ManagedKernel\ManagedPciConfiguration.cs" Link="ManagedPciConfiguration.cs" />
    <Compile Include="..\ManagedKernel\ManagedInterruptDispatcher.cs" Link="ManagedInterruptDispatcher.cs" />
    <Compile Include="..\ManagedKernel\ManagedSerialDriver.cs" Link="ManagedSerialDriver.cs" />
    <Compile Include="..\ManagedKernel\ManagedDriverWorker.cs" Link="ManagedDriverWorker.cs" />
    <Compile Include="..\ManagedKernel\ManagedKeyboardDriver.cs" Link="ManagedKeyboardDriver.cs" />
  </ItemGroup>
</Project>
